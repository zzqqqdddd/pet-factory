{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pet Factory",
  "version": "1.0.0",
  "identifier": "com.petfactory.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "pet",
        "title": "Pet Factory",
        "width": 192,
        "height": 208,
        "minWidth": 192,
        "minHeight": 208,
        "maxWidth": 192,
        "maxHeight": 208,
        "center": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "closable": false,
        "focus": false,
        "focusable": true,
        "shadow": false,
        "skipTaskbar": true,
        "visible": false,
        "visibleOnAllWorkspaces": true,
        "acceptFirstMouse": true,
        "preventOverflow": false,
        "useHttpsScheme": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Entertainment",
    "shortDescription": "Pet Factory standalone desktop pet",
    "longDescription": "A transparent, draggable, always-on-top desktop pet app powered by hatch-pet sprite atlases.",
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
